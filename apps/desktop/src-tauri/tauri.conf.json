{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Libreri",
  "version": "0.1.0",
  "identifier": "app.libreri.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Libreri",
        "width": 1280,
        "height": 800,
        "minWidth": 480,
        "minHeight": 480,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; frame-src 'self' blob: book: http://book.localhost http://127.0.0.1:*; img-src 'self' asset: book: http://book.localhost data: blob: https://*.mzstatic.com; media-src 'self' book: http://book.localhost blob: https:; connect-src 'self' ipc: http://ipc.localhost book: http://book.localhost blob: data:; style-src 'self' 'unsafe-inline' blob:; font-src 'self' data: blob: book: http://book.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Your books, notes and highlights in one local library.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "entitlements": "./Entitlements.plist",
      "minimumSystemVersion": "13.3"
    },
    "license": "GPL-3.0-or-later",
    "licenseFile": "../../../LICENSE",
    "copyright": "Copyright © 2026 avmg0 and Libreri contributors. Licensed under the GNU GPL v3 or later.",
    "fileAssociations": [
      {
        "ext": [
          "pdf"
        ],
        "name": "PDF document",
        "description": "PDF document",
        "role": "Viewer",
        "rank": "Default",
        "mimeType": "application/pdf"
      },
      {
        "ext": [
          "epub"
        ],
        "name": "EPUB book",
        "description": "EPUB book",
        "role": "Viewer",
        "rank": "Default",
        "mimeType": "application/epub+zip",
        "contentTypes": [
          "org.idpf.epub-container"
        ]
      },
      {
        "ext": [
          "mobi",
          "azw",
          "prc"
        ],
        "name": "Kindle book",
        "description": "Kindle book",
        "role": "Viewer",
        "rank": "Default",
        "mimeType": "application/x-mobipocket-ebook"
      },
      {
        "ext": [
          "azw3",
          "kf8"
        ],
        "name": "Kindle book (KF8)",
        "description": "Kindle book",
        "role": "Viewer",
        "rank": "Default",
        "mimeType": "application/vnd.amazon.mobi8-ebook"
      },
      {
        "ext": [
          "fb2"
        ],
        "name": "FictionBook",
        "description": "FictionBook",
        "role": "Viewer",
        "rank": "Default",
        "mimeType": "application/x-fictionbook+xml"
      },
      {
        "ext": [
          "djvu",
          "djv"
        ],
        "name": "DjVu document",
        "description": "DjVu document",
        "role": "Viewer",
        "rank": "Default",
        "mimeType": "image/vnd.djvu"
      },
      {
        "ext": [
          "cbz"
        ],
        "name": "Comic book (ZIP)",
        "description": "Comic book",
        "role": "Viewer",
        "rank": "Default",
        "mimeType": "application/vnd.comicbook+zip"
      },
      {
        "ext": [
          "cbr"
        ],
        "name": "Comic book (RAR)",
        "description": "Comic book",
        "role": "Viewer",
        "rank": "Default",
        "mimeType": "application/vnd.comicbook-rar"
      },
      {
        "ext": [
          "cb7"
        ],
        "name": "Comic book (7z)",
        "description": "Comic book",
        "role": "Viewer",
        "rank": "Default",
        "mimeType": "application/x-cb7"
      },
      {
        "ext": [
          "cbt"
        ],
        "name": "Comic book (TAR)",
        "description": "Comic book",
        "role": "Viewer",
        "rank": "Default",
        "mimeType": "application/x-cbt"
      },
      {
        "ext": [
          "cba"
        ],
        "name": "Comic book (ACE)",
        "description": "Comic book",
        "role": "Viewer",
        "rank": "Default"
      },
      {
        "ext": [
          "m4b"
        ],
        "name": "Audiobook",
        "description": "Audiobook",
        "role": "Viewer",
        "rank": "Default",
        "mimeType": "audio/x-m4b"
      },
      {
        "ext": [
          "md",
          "markdown"
        ],
        "name": "Markdown document",
        "description": "Markdown document",
        "role": "Viewer",
        "rank": "Alternate",
        "mimeType": "text/markdown"
      }
    ],
    "linux": {
      "deb": {
        "desktopTemplate": "linux/libreri.desktop"
      },
      "rpm": {
        "desktopTemplate": "linux/libreri.desktop"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE1QTBDRDBGMTIzRDY2NjYKUldSbVpqMFNEODJncGZsSFhoaEk1dlNoZENRUHhSRDhDK2EreEhpb01rdERZVTRGQ25lNTY5OXgK",
      "endpoints": [
        "https://github.com/avmg0/Libreri/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
